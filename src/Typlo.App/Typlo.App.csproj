<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Typlo</AssemblyName>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot Condition="'$(RuntimeIdentifier)' == 'win-x64' and '$(Configuration)' == 'Release'">true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.3" />
    <PackageReference Include="SharpHook" Version="8.0.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="Assets/Typlo.ico" LogicalName="Typlo.Assets.Typlo.ico" /></ItemGroup>
  <ItemGroup>
    <Content Include="../../resources/language-detection/*" Link="language-data/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Typlo.Core\Typlo.Core.csproj" />
    <InternalsVisibleTo Include="Typlo.Tests" />
    <InternalsVisibleTo Include="Typlo.WindowsIntegration" />
  </ItemGroup>
  <ItemGroup Condition="$([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('linux-'))">
    <Content Include="../../integrations/gnome/*" Link="gnome-extension/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
