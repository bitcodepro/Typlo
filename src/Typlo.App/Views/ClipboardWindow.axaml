<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Typlo.App.Views"
        xmlns:l="using:Typlo.App.Services"
        x:Class="Typlo.App.Views.ClipboardWindow"
        x:DataType="v:ClipboardWindow"
        Title="{l:Tr history.title}"
        Width="460" Height="560"
        CanResize="False"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="AcrylicBlur, Transparent">
  <Border Background="{DynamicResource PanelBrush}"
          BorderBrush="{DynamicResource PanelBorderBrush}"
          BorderThickness="1" CornerRadius="12" ClipToBounds="True">
    <DockPanel>
      <!-- Search -->
      <Border DockPanel.Dock="Top" Classes="searchShell" Margin="12,12,12,8">
        <Border.Styles>
          <Style Selector="Border.searchShell">
            <Setter Property="Background" Value="{DynamicResource SearchBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Transitions">
              <Transitions>
                <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                <BrushTransition Property="Background" Duration="0:0:0.15" />
              </Transitions>
            </Setter>
          </Style>
          <Style Selector="Border.searchShell:pointerover">
            <Setter Property="Background" Value="{DynamicResource SearchHoverBrush}" />
          </Style>
          <Style Selector="Border.searchShell:focus-within">
            <Setter Property="Background" Value="{DynamicResource SearchFocusBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentTextBrush}" />
          </Style>
          <!-- The text box itself is chrome-less: the shell above draws background and focus ring. -->
          <Style Selector="TextBox#SearchBox, TextBox#SearchBox:pointerover, TextBox#SearchBox:focus">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="14" />
          </Style>
          <Style Selector="TextBox#SearchBox /template/ Border#PART_BorderElement,
                           TextBox#SearchBox:pointerover /template/ Border#PART_BorderElement,
                           TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
          </Style>
          <Style Selector="TextBox#SearchBox /template/ TextBlock#PART_Placeholder">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
          </Style>
        </Border.Styles>
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0,10,0">
          <!-- Magnifier -->
          <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center"
                Stroke="{DynamicResource MutedTextBrush}" StrokeThickness="2" StrokeLineCap="Round"
                Data="M 10,10 m -7,0 a 7,7 0 1,0 14,0 a 7,7 0 1,0 -14,0 M 15,15 L 20,20" />
          <TextBox Grid.Column="1" x:Name="SearchBox" PlaceholderText="{l:Tr history.search}" Margin="10,0,8,0">
            <TextBox.Resources>
              <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
              <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
              <Thickness x:Key="TextControlBorderThemeThickness">0</Thickness>
              <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
            </TextBox.Resources>
          </TextBox>
          <Border Grid.Column="2" CornerRadius="6" Padding="7,2" VerticalAlignment="Center"
                  Background="{DynamicResource BadgeBrush}">
            <TextBlock x:Name="CountText" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource MutedTextBrush}" />
          </Border>
        </Grid>
      </Border>

      <!-- Footer hints -->
      <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0"
              Padding="12,7">
        <TextBlock FontSize="11.5" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap"
                   Text="{l:Tr history.hints}" />
      </Border>

      <Grid>
        <TextBlock x:Name="EmptyText" Text="{l:Tr history.empty}" IsVisible="False"
                   HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{DynamicResource MutedTextBrush}" />
        <ListBox x:Name="List" Background="Transparent" Padding="6,0,6,6"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,1" />
              <Setter Property="CornerRadius" Value="8" />
            </Style>
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource ItemHoverBrush}" />
            </Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
              <Setter Property="Background" Value="{DynamicResource ItemSelectedBrush}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="v:ClipItemViewModel">
              <Grid ColumnDefinitions="28,*,Auto" Margin="8,7">
                <Border Width="20" Height="20" CornerRadius="5" VerticalAlignment="Top" Margin="0,1,0,0"
                        Background="{DynamicResource BadgeBrush}" IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Spacing="3">
                  <TextBlock Text="{Binding Title}" IsVisible="{Binding IsText}" TextWrapping="Wrap"
                             MaxLines="4" TextTrimming="CharacterEllipsis" FontSize="13.5" />
                  <Border IsVisible="{Binding IsImage}" HorizontalAlignment="Left" CornerRadius="6" ClipToBounds="True"
                          BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1">
                    <Image Source="{Binding Thumbnail}" MaxHeight="110" MaxWidth="360" Stretch="Uniform" />
                  </Border>
                  <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="📌" IsVisible="{Binding Pinned}" VerticalAlignment="Top"
                           Margin="6,0,0,0" FontSize="13" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </DockPanel>
  </Border>
</Window>
