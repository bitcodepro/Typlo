<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="using:Typlo.App.Views"
        xmlns:l="using:Typlo.App.Services"
        x:Class="Typlo.App.Views.SettingsWindow"
        Title="{l:Tr settings.title}"
        Width="560" Height="760" MinWidth="480" MinHeight="500"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock.h">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
  </Window.Styles>

  <DockPanel>
    <Border DockPanel.Dock="Bottom" Padding="20,12" BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="SaveStatus" Classes="hint" VerticalAlignment="Center" />
        <Button Grid.Column="1" x:Name="CancelButton" Content="{l:Tr settings.cancel}" Margin="0,0,8,0" />
        <Button Grid.Column="2" x:Name="SaveButton" Content="{l:Tr settings.save}" Classes="accent" />
      </Grid>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="20,6,20,20">
        <Border x:Name="PlatformNoteBorder" Margin="0,12,0,0" Padding="12,8" CornerRadius="8" Background="#22F59E0B"
                IsVisible="{Binding #PlatformNote.IsVisible}">
          <TextBlock x:Name="PlatformNote" IsVisible="False" TextWrapping="Wrap" FontSize="12.5" />
        </Border>
        <TextBlock Classes="h" Text="{l:Tr settings.system}" />
        <Grid ColumnDefinitions="190,*" Margin="0,0,0,8">
          <TextBlock Classes="label" Text="{l:Tr settings.language}" />
          <ComboBox Grid.Column="1" x:Name="LanguageBox" HorizontalAlignment="Stretch" />
        </Grid>
        <CheckBox x:Name="AutostartBox" Content="{l:Tr settings.autostart}" />
        <CheckBox x:Name="KeepAwakeBox" Content="{l:Tr settings.keepAwake}" Margin="0,4,0,0" />
        <TextBlock Classes="hint" Margin="28,0,0,0"
                   Text="{l:Tr settings.keepAwakeHint}" />
        <TextBlock Classes="h" Text="{l:Tr settings.layoutHeader}" />
        <TextBlock Classes="hint" Margin="0,0,0,8"
                   Text="{l:Tr settings.layoutHint}" />
        <Grid x:Name="HotkeyGrid" ColumnDefinitions="190,*,Auto" RowDefinitions="Auto" />
        <CheckBox x:Name="SwitchLayoutBox" Margin="0,8,0,0"
                  Content="{l:Tr settings.switchLayout}" />
        <Grid ColumnDefinitions="190,*,Auto,*" Margin="0,8,0,0">
          <TextBlock Classes="label" Text="{l:Tr settings.pair}" />
          <ComboBox Grid.Column="1" x:Name="PairFirst" HorizontalAlignment="Stretch" />
          <TextBlock Grid.Column="2" Text="⇄" Margin="8,0" VerticalAlignment="Center" />
          <ComboBox Grid.Column="3" x:Name="PairSecond" HorizontalAlignment="Stretch" />
        </Grid>

        <TextBlock Classes="h" Text="{l:Tr settings.historyHeader}" />
        <CheckBox x:Name="HistoryEnabledBox" Content="{l:Tr settings.historyEnabled}" />
        <Grid ColumnDefinitions="190,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto" Margin="0,6,0,0">
          <TextBlock Classes="label" Text="{l:Tr settings.openHistory}" />
          <v:HotkeyBox Grid.Column="1" x:Name="ClipboardHotkeyBox" />
          <TextBlock Grid.Column="2" x:Name="ClipboardHotkeyStatus" Classes="status" Width="110" />

          <TextBlock Grid.Row="1" Classes="label" Text="{l:Tr settings.maxItems}" Margin="0,8,0,0" />
          <NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="MaxItemsBox" Minimum="10" Maximum="100000" Increment="50"
                         FormatString="0" Margin="0,8,0,0" />

          <TextBlock Grid.Row="2" Classes="label" Text="{l:Tr settings.maxTotal}" Margin="0,8,0,0" />
          <NumericUpDown Grid.Row="2" Grid.Column="1" x:Name="MaxTotalBox" Minimum="1" Maximum="100000" Increment="50"
                         FormatString="0" Margin="0,8,0,0" />

          <TextBlock Grid.Row="3" Classes="label" Text="{l:Tr settings.maxImage}" Margin="0,8,0,0" />
          <NumericUpDown Grid.Row="3" Grid.Column="1" x:Name="MaxImageBox" Minimum="1" Maximum="1000" Increment="5"
                         FormatString="0" Margin="0,8,0,0" />
        </Grid>
        <TextBlock Classes="label" Text="{l:Tr settings.excluded}" Margin="0,12,0,4" />
        <TextBox x:Name="ExcludedBox" />
        <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
          <TextBlock x:Name="StatsText" Classes="hint" VerticalAlignment="Center" />
          <Button Grid.Column="1" x:Name="ClearButton" Content="{l:Tr settings.clear}" />
        </Grid>
        <TextBlock Classes="hint" Margin="0,8,0,0" x:Name="StorageHint" />

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
